# Shared defaults for every machine. Machine-specific settings live in
# ~/.gitconfig.local, included at the end so they take precedence.

# Sample configuration - override in ~/.gitconfig.local
#[commit]
#    gpgsign = true

[core]
    editor = nano
    excludesfile = ~/.gitignore_global
    pager = cat

[color]
    ui = auto

[color "status"]
    added     = green bold
    changed   = yellow bold
    untracked = red bold

[color "diff"]
    old        = red bold
    new        = green bold
    frag       = cyan bold
    whitespace = red reverse

[color "branch"]
    current = cyan bold
    remote  = yellow

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = simple

[alias]
    s = status --porcelain
    l = log --oneline -10
    b = branch
    a = add
    c = commit -m
    d = diff

    info = log --oneline -1
    files = diff --name-only
    changes = status --porcelain

    unstage = reset HEAD
    undo = reset --soft HEAD~1
[gpg]
	program = gpg
# SSH commit signing: names the file that lists which public keys may sign
# for which identity. Without it git reports %G?=N on perfectly good
# signatures, because it has no trust anchor to check them against. The
# file holds PUBLIC keys only, so it is safe to commit; the private key
# never leaves ~/.ssh.
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential

# Personal overrides - included last so local settings take precedence.
[include]
    path = ~/.gitconfig.local
