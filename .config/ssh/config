# SSH client configuration
# GPG agent socket is set via SSH_AUTH_SOCK in shared/platform.sh
# This avoids hardcoded paths that differ between Linux and macOS

# Git hosting services
# Uses the dedicated passphrase-less ed25519 key (~/.ssh/id_ed25519) for
# headless/CI. IdentityFile + IdentitiesOnly yes => only that key is offered,
# so the GPG-agent key (which needs a TTY unlock) is never tried here.
# For INTERACTIVE GPG-agent SSH, see docs/headless-gpg-ssh-auth.md and
# use `ssh -o IdentitiesOnly=no git@gitlab.com` after a TTY passphrase unlock.
# Specific host directives MUST come BEFORE the Host * wildcard.
Host gitlab.com git@gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host github.com git@github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host *
    Protocol 2
    Ciphers aes256-ctr,aes192-ctr,aes128-ctr,aes256-gcm@openssh.com,aes128-gcm@openssh.com
    MACs hmac-sha2-256,hmac-sha2-512,hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com
    KexAlgorithms diffie-hellman-group16-sha512,diffie-hellman-group14-sha256,curve25519-sha256@libssh.org,diffie-hellman-group18-sha512
    HostKeyAlgorithms ssh-ed25519,ssh-rsa,ssh-ed25519-cert-v01@openssh.com,ssh-rsa-cert-v01@openssh.com

    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive yes
    Compression yes

    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no

    UserKnownHostsFile ~/.ssh/known_hosts
    StrictHostKeyChecking ask
    VerifyHostKeyDNS ask

    ControlMaster auto
    ControlPath ~/.cache/ssh/cm-%C
    ControlPersist 10m

    ForwardAgent no
    ForwardX11 no
    ForwardX11Trusted no

