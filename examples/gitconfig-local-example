# Git Local Configuration Example
# Copy to ~/.gitconfig.local and customize
# Load priority: local config overrides base config

# Note: This file is included LAST in .gitconfig, so any settings here
# take precedence over the base configuration. Typically used for:
# - Identity (REQUIRED — the tracked .gitconfig is public and sets none)
# - Personal overrides (different email/name per repo)
# - Machine-specific settings (different GPG key on another device)
# - Additional aliases or excludes

# REQUIRED: your git identity. Without this, commits fail with
# "Please tell me who you are". Use the email registered on the signing key.
[user]
    name = Your Name
    email = you@example.invalid
    signingkey = 0xXXXXXXXXXXXXXXXX

# Signing backend: omit for OpenPGP. For SSH signing set format = ssh and point
# user.signingkey at the PUBLIC key path; the tracked .gitconfig's
# gpg.ssh.allowedSignersFile is inert until gpg.format selects ssh.
# [gpg]
#     format = ssh

# Example: Override signing for specific work repos
# [commit]
#     gpgsign = false

# Example: Additional excludes
# [core]
#     excludesfile = ~/.gitignore_work

# Example: Extra aliases
# [alias]
#     wip = commit -m "wip"