#!/bin/sh
# Pre-commit hook: format/lint checks and secret detection

set -e

reject() {
  echo "ERROR: $1" >&2
  exit 1
}

# Only scan staged files (added/modified)
staged_files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged_files" ] && exit 0

# Run format/lint (best-effort)
if command -v shfmt > /dev/null 2>&1; then
  if ! make fmt-check > /dev/null 2>&1; then
    reject "shfmt check failed. Run: make fmt-check"
  fi
fi
if command -v shellcheck > /dev/null 2>&1; then
  if ! make shellcheck > /dev/null 2>&1; then
    reject "shellcheck failed. Run: make shellcheck"
  fi
fi

# Block private key / secret files by name.
# The repo's own convention is keys/*.asc (public key today, but a
# --export-secret-keys into the same path would publish the signing key), so
# .asc/.gpg/.pgp/.ppk/.der are all blocked. The SOPS age master key
# (~/.config/sops/age/keys.txt) decrypts the entire secret store and must
# never be committed.
while IFS= read -r f; do
  case "$f" in
    *.key | *.pem | *.p12 | *.pfx | *.kdb | *.keystore | *.jks | \
      *.asc | *.gpg | *.pgp | *.ppk | *.der | \
      keys.txt | *age*key*)
      reject "Possible private key/secret detected by name: $f"
      ;;
    id_rsa | id_dsa | id_ecdsa | id_ed25519 | id_ed25519_sk | id_rsa_* | id_ecdsa_* | id_dsa_*)
      reject "SSH private key detected: $f"
      ;;
    */id_rsa | */id_dsa | */id_ecdsa | */id_ed25519 | */id_ed25519_sk | */id_rsa_* | */id_ecdsa_* | */id_dsa_*)
      reject "SSH private key detected: $f"
      ;;
    *.env.mk)
      :
      ;; # .env.mk is a Makefile include, not a secrets file
    secrets/secrets.enc.yaml)
      : # SOPS-encrypted file — verify it is actually encrypted below
      ;;
    *.enc.yaml | *.enc.json | *.enc)
      :
      ;; # Other encrypted files — verify the ciphertext marker below
    *.env | .env.* | *secret*.yaml | *secret*.yml | *secret*.json | *secret)
      reject "Plaintext secrets file detected: $f"
      ;;
  esac
done << EOF
$staged_files
EOF

# Files to content-scan: everything staged EXCEPT the hook directory itself.
# The hooks contain their own detection/signature strings (e.g. the age-key
# and private-key patterns below), so scanning them would make the hook reject
# its own source on every edit. Hook files are not secret stores.
_scan_files=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^\.githooks/' || true)

# Verify staged SOPS encrypted files are actually ciphertext — by inspecting the
# STAGED BLOB, never the worktree. This is fail-CLOSED and needs no sops binary
# or decryption key, so it works for every contributor and cannot be bypassed by
# restoring the encrypted file on disk after `git add`.
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    secrets/*.enc.yaml | *.enc.yaml | *.enc.json | *.enc)
      if ! git show ":$f" 2> /dev/null | grep -q 'ENC\[AES256_GCM'; then
        reject "SOPS encrypted file is not valid ciphertext: $f (missing ENC[AES256_GCM marker)"
      fi
      ;;
  esac
done << EOF
$_scan_files
EOF

# Block PEM/OPENSSH/PGP private key CONTENT. Real headers are e.g.
# "-----BEGIN OPENSSH PRIVATE KEY-----" / "-----BEGIN RSA PRIVATE KEY-----";
# the old alternation "BEGIN (...|PRIVATE) KEY" only matched the impossible
# "BEGIN OPENSSH KEY" and let every real key through.
if [ -n "$_scan_files" ] && echo "$_scan_files" | while read -r f; do git diff --cached --unified=0 -- "$f"; done | grep -Eq -- '-----BEGIN [A-Z0-9 ]*PRIVATE KEY( BLOCK)?-----'; then
  reject "Private key content detected in staged diff"
fi

# Block SOPS age master key content (decrypts the whole store).
if [ -n "$_scan_files" ] && echo "$_scan_files" | while read -r f; do git diff --cached --unified=0 -- "$f"; done | grep -Eq -- 'AGE-SECRET-KEY-1[0-9A-Z]{50,}'; then
  reject "SOPS age master key detected in staged diff"
fi

# Block common API token patterns (best-effort). Includes GitLab PATs
# (glpat-…) because origin is GitLab and the store holds gitlab_token.
if [ -n "$_scan_files" ] && echo "$_scan_files" | while read -r f; do git diff --cached --unified=0 -- "$f"; done | grep -Eq -- '(AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|AIzaSy[0-9A-Za-z_-]{35}|ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{80,}|gh[opusr]_[0-9A-Za-z]{36,}|glpat-[0-9A-Za-z_-]{20,}|sk-(proj-)?[0-9A-Za-z_-]{20,}|xox[baprs]-[0-9A-Za-z-]{10,})'; then
  reject "Possible API token detected in staged diff"
fi

exit 0
